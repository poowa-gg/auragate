# =============================================================
# AuraGate — .gitignore
# Kiroween 2026 Hackathon
#
# IMPORTANT: .kiro/ is intentionally NOT ignored.
# The hackathon requires /.kiro at the repo root to be visible.
# Ignoring it may disqualify the submission.
# =============================================================

# ── Node.js ──────────────────────────────────────────────────
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.npm
.yarn-integrity

# ── Build output ─────────────────────────────────────────────
dist/
build/
out/

# ── Environment & secrets ────────────────────────────────────
.env
.env.local
.env.development
.env.test
.env.production
.env*.local

# ── TypeScript cache ─────────────────────────────────────────
*.tsbuildinfo
tsconfig.tsbuildinfo

# ── OS files ─────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ── Editor / IDE ─────────────────────────────────────────────
.vscode/settings.json
.vscode/launch.json
.vscode/*.code-workspace
.idea/
*.swp
*.swo

# ── Test & coverage output ───────────────────────────────────
coverage/
.nyc_output/
*.lcov

# ── Logs ─────────────────────────────────────────────────────
logs/
*.log

# ── Temporary files ──────────────────────────────────────────
*.tmp
*.temp
_gen_samples.mts

# ── Vercel (local only) ──────────────────────────────────────
.vercel
